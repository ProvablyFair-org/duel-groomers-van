"// Provably Fair Slots Verification (PCG32 PRNG)\n// This code verifies a slot spin result using outcome index + PCG32\n\n// User input values\nconst clientSeed = '';\nconst serverSeed = '';\nconst nonce = 0;\nconst roundIndex = 0;\nconst tumbleIndex = 0;\n\nconst reels = 6;\nconst rows = 5;\nconst slotId = 3;\nconst symbolWeights = null;\nconst reelConfigs = [];\nconst multiplierSymbolIndex = null;\nconst multiplierValues = null;\n\nconst MAX_UINT32 = 0xFFFFFFFF;\n\n// PCG32 PRNG implementation\nclass Pcg32 {\n    constructor(seed32) {\n        this.increment = 0x5851f42d4c957f2dn;\n        let seed64 = BigInt(seed32 >>> 0);\n\n        // Mix seed into 64-bit state\n        seed64 = (seed64 + 0x9e3779b97f4a7c15n) & 0xFFFFFFFFFFFFFFFFn;\n        seed64 = ((seed64 ^ (seed64 >> 30n)) * 0xbf58476d1ce4e5b9n) & 0xFFFFFFFFFFFFFFFFn;\n        seed64 = ((seed64 ^ (seed64 >> 27n)) * 0x94d049bb133111ebn) & 0xFFFFFFFFFFFFFFFFn;\n        seed64 ^= (seed64 >> 31n);\n\n        this.state = seed64;\n    }\n\n    nextUint32() {\n        const oldState = this.state;\n        this.state = (oldState * 6364136223846793005n + this.increment) & 0xFFFFFFFFFFFFFFFFn;\n\n        const xorShifted = Number(((oldState >> 18n) ^ oldState) >> 27n) >>> 0;\n        const rot = Number(oldState >> 59n) & 31;\n\n        return ((xorShifted >>> rot) | (xorShifted << ((32 - rot) & 31))) >>> 0;\n    }\n}\n\n// Step 1: Generate outcome index from seeds\nasync function generateOutcomeIndex(serverSeed, clientSeed, nonce) {\n    const encoder = new TextEncoder();\n    const serverSeedBuffer = hexToBytes(serverSeed);\n    const clientSeedHex = bytesToHex(encoder.encode(clientSeed));\n    const message = clientSeedHex + ':' + nonce;\n\n    const key = await crypto.subtle.importKey(\n        'raw',\n        serverSeedBuffer,\n        { name: 'HMAC', hash: 'SHA-256' },\n        false,\n        ['sign']\n    );\n\n    const signature = await crypto.subtle.sign('HMAC', key, encoder.encode(message));\n    const hash = new Uint8Array(signature);\n\n    // Extract first 4 bytes as big-endian uint32\n    const view = new DataView(hash.buffer, hash.byteOffset, 4);\n    return view.getUint32(0, false);\n}\n\n// Step 2: Derive tumble seed from outcome index, round index, and tumble index\n// For normal spins: roundIndex = 0, tumbleIndex varies per cascade\n// For bonus: roundIndex = 0,1,2... per free spin, tumbleIndex varies per cascade\nfunction deriveTumbleSeed(outcomeIndex, roundIndex, tumbleIndex) {\n    let x = outcomeIndex >>> 0;\n\n    // Mix round index (free spin index within bonus)\n    x ^= Math.imul(roundIndex + 1, 0x9e3779b9) >>> 0;\n\n    // Mix tumble/cascade index within the round\n    x ^= Math.imul(tumbleIndex + 1, 0x85ebca6b) >>> 0;\n\n    x ^= x >>> 16;\n    x = Math.imul(x, 0xc2b2ae35) >>> 0;\n    x ^= x >>> 16;\n\n    return x >>> 0;\n}\n\n// Step 3: Generate grid from PCG32 PRNG with rejection sampling for unbiased selection\nfunction generateGridFromPrng(prng, reels, rows, settings) {\n    const grid = [];\n\n    for (let col = 0; col < reels; col++) {\n        const reel = [];\n\n        // Get weights for this reel\n        let weights;\n        if (settings.reelConfigs) {\n            const reelConfig = settings.reelConfigs.find(rc => rc.reelIndex === col);\n            if (!reelConfig) throw new Error(`No config for reel ${col}`);\n            weights = reelConfig.symbolWeights;\n        } else if (settings.symbolWeights) {\n            weights = settings.symbolWeights;\n        } else {\n            throw new Error('No weights provided');\n        }\n\n        const totalWeight = weights.reduce((sum, w) => sum + w, 0);\n        const maxFair = MAX_UINT32 - (MAX_UINT32 % totalWeight);\n\n        for (let row = 0; row < rows; row++) {\n            // Rejection sampling to avoid modulo bias\n            let rnd;\n            do {\n                rnd = prng.nextUint32();\n            } while (rnd >= maxFair);\n\n            const pick = rnd % totalWeight;\n\n            let cumulativeWeight = 0;\n            let symbolIndex = 0;\n\n            for (let i = 0; i < weights.length; i++) {\n                cumulativeWeight += weights[i];\n                if (pick < cumulativeWeight) {\n                    symbolIndex = i;\n                    break;\n                }\n            }\n\n            reel.push(symbolIndex);\n        }\n\n        grid.push(reel);\n    }\n\n    return grid;\n}\n\n// Step 4: Generate multipliers for multiplier symbols\nfunction generateMultipliersForGrid(grid, reels, rows, prng, settings) {\n    const { multiplierSymbolIndex, multiplierValues } = settings;\n\n    if (multiplierSymbolIndex === undefined || multiplierSymbolIndex === null || !multiplierValues || !multiplierValues.length) {\n        return [];\n    }\n\n    const out = [];\n    const range = multiplierValues.length;\n    const maxFair = MAX_UINT32 - (MAX_UINT32 % range);\n\n    for (let c = 0; c < reels; c++) {\n        for (let r = 0; r < rows; r++) {\n            if (grid[c][r] === multiplierSymbolIndex) {\n                let rnd;\n                do {\n                    rnd = prng.nextUint32();\n                } while (rnd >= maxFair);\n\n                const idx = rnd % range;\n                out.push({\n                    position: c * rows + r,\n                    value: multiplierValues[idx],\n                });\n            }\n        }\n    }\n\n    return out;\n}\n\n// Helper functions\nfunction hexToBytes(hex) {\n    const bytes = new Uint8Array(hex.length / 2);\n    for (let i = 0; i < hex.length; i += 2) {\n        bytes[i / 2] = parseInt(hex.substr(i, 2), 16);\n    }\n    return bytes;\n}\n\nfunction bytesToHex(bytes) {\n    return Array.from(bytes)\n        .map(b => b.toString(16).padStart(2, '0'))\n        .join('');\n}\n\n// Main verification function\nasync function verifySlotsResult() {\n    console.log('=== Slots Verification (PCG32) ===');\n    console.log('Server Seed:', serverSeed);\n    console.log('Client Seed:', clientSeed);\n    console.log('Nonce:', nonce);\n    console.log('Round Index:', roundIndex);\n    console.log('Tumble Index:', tumbleIndex);\n    console.log('');\n\n    // Step 1: Generate outcome index\n    const outcomeIndex = await generateOutcomeIndex(serverSeed, clientSeed, nonce);\n    const outcomeIndexHex = outcomeIndex.toString(16).padStart(8, '0');\n    console.log('Step 1: Outcome Index:', outcomeIndex, '(0x' + outcomeIndexHex + ')');\n\n    // Step 2: Derive tumble seed\n    const tumbleSeed = deriveTumbleSeed(outcomeIndex, roundIndex, tumbleIndex);\n    const tumbleSeedHex = tumbleSeed.toString(16).padStart(8, '0');\n    console.log('Step 2: Tumble Seed:', tumbleSeed, '(0x' + tumbleSeedHex + ')');\n\n    // Step 3: Initialize PCG32 and generate grid\n    const prng = new Pcg32(tumbleSeed);\n    const settings = {\n        reels,\n        rows,\n        symbolWeights,\n        reelConfigs,\n        multiplierSymbolIndex,\n        multiplierValues\n    };\n\n    const columnMajorGrid = generateGridFromPrng(prng, reels, rows, settings);\n\n    // Step 4: Generate multipliers\n    const multipliers = generateMultipliersForGrid(columnMajorGrid, reels, rows, prng, settings);\n\n    // Transpose to row-major format (matches screen display)\n    const grid = [];\n    for (let row = 0; row < rows; row++) {\n        const rowSymbols = [];\n        for (let col = 0; col < reels; col++) {\n            rowSymbols.push(columnMajorGrid[col][row]);\n        }\n        grid.push(rowSymbols);\n    }\n\n    // Build a lookup: column-major position -> multiplier value\n    const multiplierMap = {};\n    multipliers.forEach(m => { multiplierMap[m.position] = m.value; });\n\n    console.log('\\nStep 3: Generated Grid' + (multipliers.length ? ' (symbol index, xMultiplier for multiplier symbols)' : '') + ':');\n    for (let row = 0; row < rows; row++) {\n        const cells = [];\n        for (let col = 0; col < reels; col++) {\n            const pos = col * rows + row;\n            const sym = grid[row][col];\n            const mult = multiplierMap[pos];\n            cells.push(mult !== undefined ? sym + '(x' + mult + ')' : String(sym));\n        }\n        console.log('Row', row, ':', cells.join(', '));\n    }\n\n    if (multipliers.length > 0) {\n        console.log('\\nStep 4: Multipliers:');\n        multipliers.forEach(m => {\n            const col = Math.floor(m.position / rows);\n            const row = m.position % rows;\n            console.log('  Col ' + col + ' Row ' + row + ' (position ' + m.position + ') -> x' + m.value);\n        });\n    }\n\n    return {\n        outcomeIndex,\n        outcomeIndexHex,\n        tumbleSeed,\n        tumbleSeedHex,\n        roundIndex,\n        tumbleIndex,\n        grid,\n        multipliers: multipliers.length ? multipliers : undefined\n    };\n}\n\n// Run verification\nif (serverSeed && serverSeed.trim() !== '' && clientSeed && clientSeed.trim() !== '' && nonce >= 0) {\n    verifySlotsResult().then(result => {\n        console.log('\\n=== Verification Complete ===');\n        console.log('Result:', result);\n    }).catch(err => {\n        console.error('Verification failed:', err);\n    });\n} else {\n    console.log('Please provide valid serverSeed, clientSeed, and nonce (>=0) before running.');\n}"